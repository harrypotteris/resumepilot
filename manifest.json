{
  "manifest_version": 3,
  "name": "ResumePilot Autofill",
  "version": "2.0.0",
  "description": "Auto-scans job application forms and fills them from my resume using RAG.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html" }
}